@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

# parscalar is the only architecture (kept for downstream projects)
set(QDP_PARALLEL_ARCH parscalar)
set(QDP_ARCH_PARSCALAR ON)

set(QDP_PRECISION @QDP_PRECISION@)
set(QDP_LAYOUT @QDP_LAYOUT@)
# NC, ND, NS
set(QDP_ND @QDP_ND@)
set(QDP_NC @QDP_NC@)
set(QDP_NS @QDP_NS@)
message(STATUS "QDP++:  Configuring System")
message(STATUS "QDP++:  Nc=${QDP_NC}")
message(STATUS "QDP++:  Nd=${QDP_ND}")
message(STATUS "QDP++:  Ns=${QDP_NS}")

if( ${QDP_NS} EQUAL 1 )
  set(BUILD_STAGGERED_EXAMPLES ON)
else()
  set(BUILD_WILSON_EXAMPLES ON)
endif()


if( QDP_LAYOUT STREQUAL "lexico")
  message( STATUS "QDP++: Lexicographic Layout" )
elseif( QDP_LAYOUT STREQUAL "cb2")
  message( STATUS "QDP++: CB2 (4D Checkerboard) Layout" )
elseif( QDP_LAYOUT STREQUAL "cb32")
  message( STATUS "QDP++: CB32 (32 colored ) Layout" )
elseif( QDP_LAYOUT STREQUAL "cb3d")
  message( STATUS "QDP++:  CB3D (3D checkerboarded ) Layout" )
endif()
message( STATUS "QDP++: Precision is ${QDP_PRECISION}")

set(QDP_ENABLE_BACKEND @QDP_ENABLE_BACKEND@)

if( QDP_ENABLE_BACKEND STREQUAL "ROCM" )
  set(QDP_BACKEND_ROCM 1)
elseif( QDP_ENABLE_BACKEND STREQUAL "CUDA")
  set(QDP_BACKEND_CUDA 1)
elseif( QDP_ENABLE_BACKEND STREQUAL "L0")
  set(QDP_BACKEND_L0 1)
endif()

find_dependency(QMP REQUIRED)


if(QDP_HOST_COMPILER)
  set(QDP_HOST_COMPILER "1")
endif()






set(QDP_IS_QDPJIT 1)
set(QDP_IS_QDPJIT2 1)

# This is just in case we want to rebuild the examples as 
# an external
set(QDP_PRECISION @qdpPrecision@)
set(QDP_LAYOUT    @qdpLayout@)
 
# Find submodules.
# I am working on the premise that in a regular build currently
# These will be installed in parallel with QDP++
# 
# However, the user is permitted to specify them by pointing 
# XPathReader_DIR, FileDB_DIR, LibIntrin_DIR and QIO_DIR to 
# directories conttaining the PackageXXXConfig.cmake files
#
if("@XPathReader_DIR@" STREQUAL "")
  list(APPEND CMAKE_PREFIX_PATH ${CMAKE_CURRENT_LIST_DIR}/../XPathReader)
endif()
 
if("@FileDB_DIR@" STREQUAL "")
  list(APPEND CMAKE_PREFIX_PATH ${CMAKE_CURRENT_LIST_DIR}/../FileDB)
endif()

if("@QIO_DIR@" STREQUAL "")
  list(APPEND CMAKE_PREFIX_PATH ${CMAKE_CURRENT_LIST_DIR}/../QIO)
endif()



set(QDP_ENABLE_BACKEND @QDP_ENABLE_BACKEND@)
set(QDP_ROCM_PATH_CONFIGURED "@ROCM_PATH@")


set(QDP_LLVM_VERSION_MAJOR @QDP_LLVM_VERSION_MAJOR@)
set(QDP_LLVM_VERSION_MINOR @QDP_LLVM_VERSION_MINOR@)
set(QDP_LLVM_PACKAGE_VERSION "@LLVM_PACKAGE_VERSION@")

if(QDP_BACKEND_ROCM)
  set(QDP_ROCM_PATH_CONFIGURED "@ROCM_PATH@")

  if(NOT DEFINED ROCM_PATH)
    if(DEFINED ENV{ROCM_PATH})
      set(ROCM_PATH "$ENV{ROCM_PATH}" CACHE PATH "ROCm installation prefix")
    elseif(NOT QDP_ROCM_PATH_CONFIGURED STREQUAL "")
      set(ROCM_PATH "${QDP_ROCM_PATH_CONFIGURED}" CACHE PATH "ROCm installation prefix")
    else()
      set(ROCM_PATH "/opt/rocm" CACHE PATH "ROCm installation prefix")
    endif()
  endif()

  if(NOT DEFINED LLVM_DIR)
    set(LLVM_DIR "${ROCM_PATH}/lib/llvm/lib/cmake/llvm"
        CACHE PATH "LLVMConfig.cmake from ROCm LLVM")
  endif()

  list(PREPEND CMAKE_PREFIX_PATH
    "${ROCM_PATH}"
    "${ROCM_PATH}/lib/llvm"
  )
endif()

find_package(LLVM CONFIG REQUIRED)

if(NOT LLVM_VERSION_MAJOR EQUAL QDP_LLVM_VERSION_MAJOR)
  message(FATAL_ERROR
    "QDPXX was built with LLVM major version ${QDP_LLVM_VERSION_MAJOR} "
    "(${QDP_LLVM_PACKAGE_VERSION}), but this project found "
    "LLVM ${LLVM_PACKAGE_VERSION}. "
    "Use a compatible LLVM installation, for example by setting LLVM_DIR.")
endif()

message(STATUS "QDPXX: Found compatible LLVM ${LLVM_PACKAGE_VERSION}")
message(STATUS "QDPXX: Using LLVMConfig.cmake in ${LLVM_DIR}")





find_dependency(XPathReader REQUIRED)
find_dependency(FileDB REQUIRED)
find_dependency(QIO REQUIRED)



# Optional dependencies
# TBB 
if(@QDP_USE_TBBPOOL_ALLOCATOR@) 
  find_dependency(TBB REQUIRED)
endif()

# HDF5
if(@QDP_USE_HDF5@)
  find_dependency(HDF5 REQUIRED)
endif()

if(NOT Threads_FOUND )
  find_dependency(Threads REQUIRED)
endif()

# Target Dependent dependencies
if( QDP_BACKEND_CUDA )
  find_dependency(CUDAToolkit REQUIRED)
elseif(QDP_BACKEND_ROCM)
  if(NOT DEFINED ROCM_PATH)
    if(DEFINED ENV{ROCM_PATH})
      set(ROCM_PATH "$ENV{ROCM_PATH}" CACHE PATH "ROCm installation prefix")
    elseif(NOT QDP_ROCM_PATH_CONFIGURED STREQUAL "")
      set(ROCM_PATH "${QDP_ROCM_PATH_CONFIGURED}" CACHE PATH "ROCm installation prefix")
    else()
      set(ROCM_PATH "/opt/rocm" CACHE PATH "ROCm installation prefix")
    endif()
  endif()

  if(NOT DEFINED hip_DIR)
    set(hip_DIR "${ROCM_PATH}/lib/cmake/hip"
        CACHE PATH "HIP CMake package")
  endif()

  list(PREPEND CMAKE_PREFIX_PATH
    "${ROCM_PATH}"
    "${ROCM_PATH}/lib/cmake"
    "${ROCM_PATH}/lib/llvm"
  )

  find_dependency(hip REQUIRED)

  set(QDP_USE_ROCM_STATS @QDP_USE_ROCM_STATS@)
  set(QDP_JIT_ROCM_COMGR_LINK @QDP_JIT_ROCM_COMGR_LINK@)
  if(QDP_USE_ROCM_STATS OR QDP_JIT_ROCM_COMGR_LINK)
    find_dependency(amd_comgr CONFIG REQUIRED)
  endif()
elseif( QDP_BACKEND_L0 )
  find_dependency(LevelZero REQUIRED)

  # QDPXX::jit links against PkgConfig::PKG_LLVMSPIRV (the SPIR-V translator).
  # Recreate that imported target, looking first where it was found at build time.
  if(NOT TARGET PkgConfig::PKG_LLVMSPIRV)
    find_dependency(PkgConfig REQUIRED)
    set(QDP_LLVMSPIRV_PCFILEDIR "@QDP_LLVMSPIRV_PCFILEDIR@")
    if(QDP_LLVMSPIRV_PCFILEDIR)
      if(DEFINED ENV{PKG_CONFIG_PATH} AND NOT "$ENV{PKG_CONFIG_PATH}" STREQUAL "")
        set(ENV{PKG_CONFIG_PATH} "${QDP_LLVMSPIRV_PCFILEDIR}:$ENV{PKG_CONFIG_PATH}")
      else()
        set(ENV{PKG_CONFIG_PATH} "${QDP_LLVMSPIRV_PCFILEDIR}")
      endif()
    endif()
    pkg_check_modules(PKG_LLVMSPIRV REQUIRED IMPORTED_TARGET LLVMSPIRVLib)
  endif()
endif()



include(${CMAKE_CURRENT_LIST_DIR}/QDPXXTargets.cmake)
